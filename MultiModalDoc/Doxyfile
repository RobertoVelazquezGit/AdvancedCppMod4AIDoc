PROJECT_NAME = MultiModalDoc
PROJECT_BRIEF = "Mock documentation generation and prompt management in C++"
OUTPUT_DIRECTORY = docs
OUTPUT_LANGUAGE = English
INPUT = .
FILE_PATTERNS = *.h *.cpp *.md
RECURSIVE = YES
EXCLUDE = docs x64 Debug Release
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT = YES
OPTIMIZE_OUTPUT_FOR_C = NO
EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
SOURCE_BROWSER = YES
INLINE_SOURCES = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION = YES
GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_LATEX = NO
HAVE_DOT = YES
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
INCLUDE_GRAPH = YES
INCLUDED_BY_GRAPH = YES
CALL_GRAPH = YES
CALLER_GRAPH = YES
DOT_IMAGE_FORMAT = svg
QUIET = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_LOGFILE = docs/doxygen-warnings.log
